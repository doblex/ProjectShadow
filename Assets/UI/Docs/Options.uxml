<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/BaseStyle.uss?fileID=7433441132597879392&amp;guid=68e07a90f95c56a49bc397c5316dfdba&amp;type=3#BaseStyle" />
    <ui:VisualElement name="BackGround" style="flex-grow: 1; background-color: rgb(255, 255, 255); justify-content: center; background-image: url(&quot;project://database/Assets/Texture/UI/backGrounds/Background%20opzioni.png?fileID=2800000&amp;guid=daecbab96dd23cd469085084cb70468c&amp;type=3#Background opzioni&quot;);">
        <ui:VisualElement name="OptionsBackGround" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Texture/UI/backGrounds/Casella%20opzioni.png?fileID=2800000&amp;guid=bd7bb6edceaf7f54e975ddb4a2d81ab8&amp;type=3#Casella opzioni&quot;); -unity-background-scale-mode: scale-to-fit; flex-direction: row; justify-content: center;">
            <ui:VisualElement data-source="project://database/Assets/ScriptableObjects/Options.asset?fileID=11400000&amp;guid=65c2a89ac08c0ca4fb599e47979138dd&amp;type=2#Options" name="OptionsContainer" style="flex-grow: 0; width: 90%; align-self: center; height: 85%; background-image: none; -unity-background-scale-mode: scale-to-fit; background-size: cover; position: relative; top: auto;">
                <ui:VisualElement name="Buttons" style="flex-grow: 0; flex-direction: row;">
                    <ui:Button name="Back" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Texture/UI/Icons/Freccia%20indietro.png?fileID=2800000&amp;guid=e96b66956c5e658458e693f9705b0aaa&amp;type=3#Freccia indietro&quot;); -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; width: auto; align-items: flex-start; align-self: flex-start;" />
                </ui:VisualElement>
                <ui:GroupBox name="Volumes" style="align-items: center;">
                    <ui:VisualElement class="OptionHead" style="flex-grow: 1; flex-direction: row;">
                        <ui:Slider label="Volume&#10;" value="42" high-value="1" style="flex-grow: 1;">
                            <Bindings>
                                <ui:DataBinding property="value" data-source-path="generalVolume" binding-mode="TwoWay" />
                            </Bindings>
                        </ui:Slider>
                        <ui:VisualElement style="flex-grow: 0; width: 10%;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="OptionChild" style="flex-grow: 1; flex-direction: row;">
                        <ui:Slider label="Music" value="42" high-value="1" style="flex-grow: 1;">
                            <Bindings>
                                <ui:DataBinding property="value" data-source-path="musicVolume" binding-mode="TwoWay" />
                            </Bindings>
                        </ui:Slider>
                        <ui:VisualElement style="flex-grow: 0; width: 1%;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="OptionChild" style="flex-grow: 1; flex-direction: row;">
                        <ui:Slider label="SFX" value="42" high-value="1" fill="false" style="flex-grow: 1;">
                            <Bindings>
                                <ui:DataBinding property="value" data-source-path="sfxVolume" binding-mode="TwoWay" />
                            </Bindings>
                        </ui:Slider>
                        <ui:VisualElement style="flex-grow: 0; width: 1%;" />
                    </ui:VisualElement>
                </ui:GroupBox>
                <ui:GroupBox name="Resolution">
                    <ui:VisualElement class="OptionHead" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="Resolution" style="-unity-text-align: middle-center;" />
                        <ui:VisualElement style="flex-grow: 1;" />
                        <ui:DropdownField>
                            <Bindings>
                                <ui:DataBinding property="choices" data-source-path="resolutions" binding-mode="TwoWay" />
                                <ui:DataBinding property="index" data-source-path="selectedResolutionIndex" binding-mode="TwoWay" />
                            </Bindings>
                        </ui:DropdownField>
                        <ui:VisualElement style="flex-grow: 0; width: 20%;" />
                    </ui:VisualElement>
                </ui:GroupBox>
                <ui:GroupBox name="FullScreen">
                    <ui:VisualElement class="OptionHead" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="FullScreen" />
                        <ui:VisualElement style="flex-grow: 1;" />
                        <ui:Toggle data-source-path="isFullScreen" />
                        <ui:VisualElement style="flex-grow: 0; width: 20%;" />
                    </ui:VisualElement>
                </ui:GroupBox>
                <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Texture/UI/Keyboard%20options.png?fileID=2800000&amp;guid=320a2bc8cec483d4b95d6e1049386238&amp;type=3#Keyboard options&quot;); -unity-background-scale-mode: scale-to-fit;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
