                    <ui:VisualElement name="Top" class="CreditsGroup" style="flex-grow: 0;">
                        <ui:Label text="Concept Artists" class="CreditsTiltle" />
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:Label text="Christian Dianin" class="CreditsPeople" />
